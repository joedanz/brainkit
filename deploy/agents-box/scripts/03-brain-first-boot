#!/command/with-contenv sh
# shellcheck shell=sh
# hermes-brain first boot: install the company-brain profile, mint this
# container's deploy key, and hand the volumes to the hermes runtime user.
#
# Runs as root from s6 cont-init on EVERY container start (after the stock
# 01-hermes-setup hook has seeded hermes defaults) — everything here must be
# idempotent. The actual vault clone happens in the supervised vault-sync
# service, never here: boot must not block on the operator authorizing the key.
set -eu

DATA=/opt/data
SUBHOME="$DATA/home"   # HOME for hermes tool subprocesses (git, ssh)
SCRATCH="$DATA/.cache/tmp"   # TMPDIR from the image; created in section 3

if [ -z "${BRAIN_PERSON:-}" ]; then
    echo "[brain] BRAIN_PERSON not set — skipping brain first-boot (plain hermes container)"
    exit 0
fi

# --- 1. company-brain profile ------------------------------------------------
# Installed once, then RE-SYNCED when the image's brainkit build changes.
#
# The sentinel used to hold only a timestamp, and the gate was its mere
# existence — so a newer image could land, the container be recreated onto it,
# and the profile never update. Every embark agent was in that state: installed
# 2026-07-20, running an image built two days later. Nothing detected it because
# nothing recorded WHICH build had been applied.
#
# What re-syncs and what does not is the whole design:
#   skills/      refreshed — additive, and the image is the source of truth
#   SOUL.md      only when untouched since we wrote it (hash recorded at install)
#   config.yaml  NEVER — hermes rewrites it at runtime (model, _config_version,
#                plugins, approvals…). Regenerating from the template would
#                discard live settings, including the model the operator chose.
#
# The SOUL rule is the dpkg-conffile pattern: ship updates to a file the local
# side may also edit, by remembering what we last wrote. Equal hash means
# untouched and safe to advance; different means someone meant it, so leave it
# and say so.
SENTINEL="$DATA/.company-brain-installed"

# `brain --version` prints "brain 0.2.0 (rev abc123def456)" for a git install —
# the revision comes from PEP 610 install metadata, so the image describes itself
# and cannot name a commit it does not contain.
#
# The WHOLE string is the build identity, not just the revision, because a
# release install has no revision to report: the version already identifies the
# code exactly, so `revision()` correctly returns None. Keying on the revision
# alone would mean every PyPI-installed image recorded the same empty value and
# re-syncs stopped being detectable the moment this image stops installing from
# git. Version-only, revision-only, and both are all covered by comparing the
# line as it is printed. head -1 keeps a future multi-line --version from
# corrupting the key=value file.
image_id="$(/usr/local/bin/brain --version 2>/dev/null | head -1)"
[ -n "$image_id" ] || image_id=unknown

sentinel_field() {
    [ -f "$SENTINEL" ] || return 0
    sed -n "s/^$1=//p" "$SENTINEL" | tail -1
}
file_md5() { md5sum "$1" 2>/dev/null | cut -d' ' -f1; }
install_skills() { mkdir -p "$DATA/skills"; cp -R /opt/brain-profile/skills/. "$DATA/skills/"; }

# The scratch-path block this script maintains at the end of SOUL.md — see the
# section that applies it, below the re-sync. Declared up here because the
# re-sync's own hash comparison has to be able to ignore it.
SCRATCH_BEGIN='<!-- hermes-brain: scratch (managed — replaced on every boot) -->'
SCRATCH_END='<!-- /hermes-brain: scratch -->'

# SOUL.md as it would be WITHOUT our block, plus any trailing blank lines the
# block was separated by. Stripping is what makes appending idempotent: the
# next boot removes exactly what the last one added before comparing.
strip_scratch_block() {
    awk -v b="$SCRATCH_BEGIN" -v e="$SCRATCH_END" '
        $0 == b { skip = 1 }
        skip == 0 { line[++n] = $0 }
        $0 == e { skip = 0 }
        END {
            while (n > 0 && line[n] == "") n--
            for (i = 1; i <= n; i++) print line[i]
        }
    ' "$1"
}

# The hash the sentinel records, and the ONLY one it may record.
#
# soul_md5 answers exactly one question — has a human touched SOUL.md since we
# wrote it — and the re-sync overwrites the file when the answer is no. Once
# this script also appends to SOUL.md, hashing the raw file would make our own
# append look like a human edit (blocking every future SOUL update), and
# re-recording the raw hash after appending would make a human's edit look like
# our own (destroying it on the next image roll). Hashing the stripped content
# is what keeps both answers right.
#
# Empty for a missing file, matching file_md5 — `strip | md5sum` would instead
# return the hash of the empty string and turn "gone" into "edited".
soul_fingerprint() {
    [ -f "$1" ] || return 0
    strip_scratch_block "$1" 2>/dev/null | md5sum | cut -d' ' -f1
}

# The original install date, from either sentinel shape — key=value, or the bare
# ISO timestamp the pre-re-sync version wrote. Carried through every rewrite so
# an agent's true age is not reset to whenever it last happened to update.
original_install_time() {
    t="$(sentinel_field installed_at)"
    [ -n "$t" ] || t="$(head -1 "$SENTINEL")"
    printf '%s\n' "$t"
}

# key=value lines. $1 = original install time (preserved across re-syncs so the
# agent's true age is not lost), $2 = the SOUL hash now on disk.
write_sentinel() {
    printf 'installed_at=%s\nbuild=%s\nsoul_md5=%s\nsynced_at=%s\n' \
        "$1" "$image_id" "$2" "$(date -u +%FT%TZ)" > "$SENTINEL"
}

if [ ! -f "$SENTINEL" ]; then
    cp /opt/brain-profile/SOUL.md "$DATA/SOUL.md"
    install_skills

    # Profile config with the vault path filled in, plus the pieces that only
    # make sense server-side: the brain MCP server and tool-loop hard stops
    # (an unattended gateway has no human watching repeated tool-call warnings).
    sed 's|REPLACE_WITH_VAULT_PATH|/vault|' /opt/brain-profile/config.yaml \
        > "$DATA/config.yaml"
    cat >> "$DATA/config.yaml" <<'EOF'

# --- appended by hermes-brain first boot ---
mcp_servers:
  brain:
    command: /usr/local/bin/brain
    args: ["mcp", "--vault", "/vault"]

tool_loop_guardrails:
  hard_stop_enabled: true
  hard_stop_after:
    exact_failure: 5
    idempotent_no_progress: 5
EOF
    write_sentinel "$(date -u +%FT%TZ)" "$(soul_fingerprint "$DATA/SOUL.md")"
    echo "[brain] company-brain profile installed for $BRAIN_PERSON ($image_id)"

elif [ "$(sentinel_field build)" != "$image_id" ]; then
    recorded_build="$(sentinel_field build)"
    installed_at="$(original_install_time)"

    install_skills

    recorded_soul="$(sentinel_field soul_md5)"
    live_soul="$(soul_fingerprint "$DATA/SOUL.md")"
    # What the IMAGE ships. The sentinel records THIS, never the live hash —
    # see the write_sentinel call below for why that distinction is the whole
    # correctness of this block.
    image_soul="$(soul_fingerprint /opt/brain-profile/SOUL.md)"
    if [ -z "$live_soul" ]; then
        : # Gone, not edited. The heal below restores it and records the hash;
          # calling that "locally modified" here would be a lie.
    elif [ -z "$recorded_soul" ]; then
        # Legacy sentinel: no record of what we shipped, so we cannot tell an
        # edited SOUL from an untouched one. Never overwrite on a guess.
        echo "[brain] SOUL.md left as-is (no recorded hash to compare — first re-sync since the sentinel gained one)"
    elif [ "$recorded_soul" = "$live_soul" ]; then
        cp /opt/brain-profile/SOUL.md "$DATA/SOUL.md"
        echo "[brain] SOUL.md updated from the image (was unmodified)"
    else
        echo "[brain] SOUL.md locally modified — left as-is; the image's version was NOT applied"
    fi

    # The sentinel records WHAT THE IMAGE SHIPPED, not what is on disk.
    #
    # Recording the live hash is what destroyed four agents' identities on
    # 2026-08-14. The fleet writes a "Your name is <X>." line into SOUL.md, so
    # every agent's file diverges from the image. Under the old code the
    # locally-modified branch left the file alone — correctly — and then
    # recorded the MODIFIED hash as the new baseline. On the next image change
    # `recorded = live` was therefore true, the file was declared "unmodified",
    # and the image's copy replaced it. A customised SOUL survived exactly one
    # upgrade and died on the second, and the log line said "was unmodified"
    # about a file nobody had left untouched.
    #
    # Recording the image's hash makes the comparison mean what it reads as:
    # "is the live file still the one we shipped?". A diverged file answers no
    # every time, forever, instead of drifting back into being overwritable.
    #
    # The cost is the dpkg-conffile cost, and it is the right one: once an
    # agent's SOUL.md is customised, brainkit stops updating it. Improvements
    # to the shipped SOUL reach new agents and untouched ones, never a
    # customised one. Silent data loss is not a better trade.
    write_sentinel "$installed_at" "$image_soul"
    echo "[brain] profile re-synced ${recorded_build:-<unrecorded>} -> $image_id (config.yaml untouched — hermes owns it)"
fi

# Heal a SOUL.md that vanished — a hand deletion, or a restore from a backup
# that predates it. An absent file is not a local edit: nobody means for their
# agent to have no instructions at all, so unlike a *modified* SOUL this is safe
# to replace. Every boot rather than only on a build change, for the same reason
# the deploy-key chmod below is: the alternative is an agent that quietly has no
# soul until the next image happens to land. This is also the documented way to
# ask for the image's version back.
if [ ! -f "$DATA/SOUL.md" ]; then
    cp /opt/brain-profile/SOUL.md "$DATA/SOUL.md"
    write_sentinel "$(original_install_time)" "$(soul_fingerprint "$DATA/SOUL.md")"
    echo "[brain] SOUL.md was missing — restored from the image"
fi

# --- SOUL.md: where scratch files go (managed block, every boot) -------------
# TMPDIR (set in the Dockerfile) covers everything that asks the OS for a temp
# path — tempfile, subprocesses, shell redirection. It does NOT cover the model
# deciding on its own to `write_file` into /tmp, which is the case that actually
# bites: the write is denied by HERMES_WRITE_SAFE_ROOT, and the agent finds out
# only from the file-mutation verifier footer, after it has already told the
# user it wrote the file.
#
# So the path has to be in the prompt too. SOUL.md and not a skill, because
# SOUL.md is the stable tier of the system prompt and is present on every turn,
# while a skill body enters context only once its description matches the task
# — and the moment this matters (a capture script, a one-off probe) never
# mentions the brain protocol.
#
# A marked block re-applied on every boot, not a template edit, for the reason
# the restart-ping loop below gives: the template reaches only volumes that do
# not exist yet. The re-sync above applies the image's SOUL.md only to an
# untouched file, and no agent's is untouched — the portal writes a name
# declaration into it during onboarding. A template-only change would reach
# precisely the agents nobody is waiting for.
#
# The sentinel is deliberately NOT rewritten here: soul_fingerprint already
# hides this block from it, so the human-edit detector keeps working.
#
# Guarded end to end — a scratch-path hint is never worth failing a boot over.
if [ -f "$DATA/SOUL.md" ]; then
    soul_tmp="$DATA/.SOUL.md.scratch-tmp"
    if {
        strip_scratch_block "$DATA/SOUL.md"
        printf '\n%s\n' "$SCRATCH_BEGIN"
        cat <<EOF
## Scratch files

Throwaway files — probe scripts, captures, downloads, anything you are not
keeping — go in \`$SCRATCH\`, which is also \`\$TMPDIR\`. \`/tmp\` is outside
this container's write guard, so writing there fails and you are told only
after the fact. Nothing under \`.cache/\` is backed up; anything worth keeping
belongs in the vault.
EOF
        printf '%s\n' "$SCRATCH_END"
    } > "$soul_tmp" 2>/dev/null && [ -s "$soul_tmp" ]; then
        # cmp, not two hashes: the question here is only "did anything change",
        # and unlike soul_fingerprint nothing stores the answer.
        if cmp -s "$soul_tmp" "$DATA/SOUL.md"; then
            rm -f "$soul_tmp"
        else
            mv "$soul_tmp" "$DATA/SOUL.md"
            echo "[brain] SOUL.md scratch block applied ($SCRATCH)"
        fi
    else
        rm -f "$soul_tmp"
        echo "[brain] could not apply the SOUL.md scratch block — left as-is"
    fi
fi

# Silence the gateway's restart pings on agents provisioned before the profile
# carried the flag. The template above can only ever reach a NEW volume, because
# config.yaml is never re-synced (see the rule at the top of this file) — so
# without this, every agent that already exists keeps mailing its user "Gateway
# shutting down" on every image roll, forever, as does any future restore from a
# backup that predates the change.
#
# `hermes config set`, never a shell append: a second top-level `telegram:` key
# would make config.yaml unparseable, and the CLI does a real YAML merge that
# leaves the runtime keys hermes owns (model, _config_version, plugins) alone.
#
# Only when UNSET. An operator who deliberately turns pings back on must not find
# them off again after the next boot — the same "we only replace what we know we
# wrote" stance the SOUL.md rule takes above.
#
# Fully guarded: this script runs `set -eu`, and a lifecycle notification is
# never worth failing a boot over.
for plat in telegram email; do
    key="$plat.gateway_restart_notification"
    if su hermes -s /bin/sh -c "hermes config get '$key'" >/dev/null 2>&1; then
        continue        # already decided, by us or by the operator
    fi
    if su hermes -s /bin/sh -c "hermes config set '$key' false" >/dev/null 2>&1; then
        echo "[brain] $key -> false (gateway lifecycle pings off)"
    else
        echo "[brain] could not set $key — left as-is, agent may ping on restart"
    fi
done

# --- 2. deploy key (once) — the private key never leaves this container ----
# ssh finds it via /etc/ssh/ssh_config.d/brain.conf (absolute paths, baked
# into the image): OpenSSH resolves ~ from the passwd entry, not $HOME, so a
# per-user config here would never be read.
if [ ! -f "$SUBHOME/.ssh/id_ed25519" ]; then
    mkdir -p "$SUBHOME/.ssh"
    ssh-keygen -q -t ed25519 -N "" -C "brain-agent-$BRAIN_PERSON" \
        -f "$SUBHOME/.ssh/id_ed25519"
    cp "$SUBHOME/.ssh/id_ed25519.pub" "$DATA/deploy-key.pub"
fi
# Every boot, not just creation: `hermes import` restores don't preserve file
# modes — an 0644 key is refused by ssh and sync dies. The documented restore
# flow ends in a restart, so healing here makes restores just work.
chmod 700 "$SUBHOME/.ssh"
chmod 600 "$SUBHOME/.ssh/id_ed25519"

# Until the clone has succeeded, surface the pubkey on every boot so it is
# always one `docker logs <container>` away.
if [ ! -d /vault/.git ]; then
    echo "============================================================"
    echo "[brain] deploy key for '$BRAIN_PERSON' — authorize it on the brain box:"
    echo
    cat "$DATA/deploy-key.pub"
    echo
    echo "[brain] (see deploy/agents-box/add-agent.sh for the exact authorized_keys line)"
    echo "[brain] vault-sync retries the clone every 30s until the key works."
    echo "============================================================"
fi

# --- 3. ownership -----------------------------------------------------------
# The stock 01 hook fixes /opt/data before we run; fix what we created after
# it, plus the fresh /vault volume (named volumes are born root-owned).
# mkdir covers a bare `docker run` without the vault mount.
mkdir -p /vault

# TMPDIR (Dockerfile) has to exist before anything supervised starts, or the
# first tool to ask the OS for a temp path gets an error instead of a
# directory. Here rather than in the image because /opt/data is a volume mount,
# which masks whatever the build wrote there.
#
# chown, never `chown -R`: .cache is also where a browser download or a pip
# wheel cache lands — hundreds of MB — and walking it on every boot is pure
# cost for no ownership we do not already have.
mkdir -p "$SCRATCH"
chown hermes:hermes "$DATA/.cache" "$SCRATCH"

chown -R hermes:hermes /vault "$SUBHOME/.ssh" "$DATA/skills"
chown hermes:hermes "$DATA/SOUL.md" "$DATA/config.yaml" \
    "$DATA/deploy-key.pub" "$DATA/.company-brain-installed"
