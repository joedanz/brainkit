#!/usr/bin/env python3
"""brain-context-scan: would this container's own Hermes drop a context file?

Hermes Agent replaces a whole context file (AGENTS.md, CLAUDE.md, SOUL.md)
with a one-line [BLOCKED: ...] notice when any line matches its threat
filter, and the agent then runs without it. brainkit renders around its own
copy of that filter; this checks with the exact Hermes build in this image,
which catches drift between the two.

Run it with Hermes's interpreter, so the import below is Hermes's own:

    /opt/hermes/.venv/bin/python brain-context-scan [--marker PATH] FILE...

For each FILE that exists: strip one leading BOM (as Hermes's prompt
builder does) and run tools.threat_patterns.scan_for_threats(text,
"context"). Prints `name:id,id ...` for blocked files and exits 3; exits 0
when everything is clean.

--marker PATH: rewritten on any hit, removed on a clean pass.
agents-liveness.sh reports it.

If Hermes's internals moved (ImportError), print nothing, leave the marker
alone and exit 0: this is a safety net, not a gate.
"""

import contextlib
import os
import sys
import tempfile


def main(argv: list[str]) -> int:
    marker = None
    if argv[:1] == ["--marker"]:
        if len(argv) < 2:
            print("usage: brain-context-scan [--marker PATH] FILE...", file=sys.stderr)
            return 2
        marker, argv = argv[1], argv[2:]
    try:
        from tools.threat_patterns import scan_for_threats
    except ImportError:
        return 0
    words = []
    for path in argv:
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError:
            continue  # not there yet (vault still cloning): nothing to drop
        if text.startswith("﻿"):
            text = text[1:]
        hits = scan_for_threats(text, "context")
        if hits:
            words.append(f"{os.path.basename(path)}:{','.join(hits)}")
    if words:
        print(" ".join(words))
    if marker:
        if words:
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(marker) or ".",
                                       prefix=".brain-context-blocked.")
            with os.fdopen(fd, "w") as fh:
                fh.write(" ".join(words) + "\n")
            os.replace(tmp, marker)
        else:
            with contextlib.suppress(FileNotFoundError):
                os.remove(marker)
    return 3 if words else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
